{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.cids-cli/schemas/week-import-v1.json",
  "title": "CIDS weekly lesson import",
  "type": "object",
  "required": ["version", "week", "entries"],
  "properties": {
    "version": {"enum": [1, "1"]},
    "week": {"type": "integer", "minimum": 1, "maximum": 53},
    "generated": {"type": "string", "format": "date-time"},
    "entry_count": {"type": "integer", "minimum": 1},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "date", "time_from", "time_to", "topic", "cs_code", "ls_code",
          "activity_html", "reflection_html", "notes_html"
        ],
        "properties": {
          "class_name": {"type": "string"},
          "class_code": {"type": "string"},
          "class_id": {"type": "string"},
          "day": {"type": "string"},
          "date": {"type": "string", "format": "date"},
          "time_from": {"type": "string", "pattern": "^(?:0?[1-9]|1[0-2]):[0-5][0-9] [AP]M$"},
          "time_to": {"type": "string", "pattern": "^(?:0?[1-9]|1[0-2]):[0-5][0-9] [AP]M$"},
          "topic": {"type": "string", "minLength": 1},
          "cs_code": {"type": "string", "minLength": 1},
          "ls_code": {"type": "string", "minLength": 1},
          "activity_html": {"type": "string", "minLength": 1},
          "reflection_html": {"type": "string", "minLength": 1},
          "notes_html": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
